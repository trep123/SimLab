{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simlab.local/schemas/runtime-profile.schema.json",
  "title": "SimLab Runtime Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "release_version", "backend", "architecture", "capabilities", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "release_version": {"type": "string"},
    "backend": {"enum": ["qemu", "container", "logical"]},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "machine": {"type": "string"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "limits": {
      "type": "object",
      "required": ["max_vcpus", "max_memory_mib"],
      "properties": {
        "max_vcpus": {"type": "integer", "minimum": 1},
        "max_memory_mib": {"type": "integer", "minimum": 128}
      }
    },
    "image_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}
