      "args": [
        {
          "name": "interface",
          "type": "interface",
          "required": false,
          "help": "接口名称，缺省为全部接口"
        }
      ],
      "output": [
        "Brief information on interfaces in route mode:",
        "Link: ADM - administratively down; Stby - standby",
        "Protocol: (s) - spoofing",
        "{interface_brief_table}"
      ]
    },
