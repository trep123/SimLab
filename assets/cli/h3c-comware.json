      "syntax": "display version",
      "aliases": [
        "dis ver",
        "dis version",
        "display ver"
      ],
      "modes": [
        "user",
        "config",
        "interface",
        "vlan"
      ],
      "help": "查看系统软件版本与运行时间",
      "handler": "show_version",
      "args": [],
      "output": [
        "H3C {os_version}",
        "Copyright (c) 2004-2024 New H3C Technologies Co., Ltd. All rights reserved.",
        "H3C {product_name} uptime is {uptime}",
        "",
        "CPU type            : Celeron 1047UE 1.40GHz",
        "512M bytes DDR3 SDRAM Memory",
        "1024M bytes Flash Memory",
        "Hardware Version    : 3.0",
        "CPLD Version        : 3.0",
        "BootWare Version    : 1.42",
        "",
        "Slot 1: {model}",
        "  Subslot 0: 24-port GE + 4-port 10G Ethernet optical interface module",
        "  Board Version : 3.0",
        "  Serial Number : {serial_number}",
        "  MAC Address   : {mac_address}"
      ]
    },
    {
