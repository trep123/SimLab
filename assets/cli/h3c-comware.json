      " description {vlan_description}",
      " quit"
    ],
    "vlan_interface": [
      "interface Vlan-interface{vlan}",
      " ip address {ip} {mask}",
      " quit"
    ],
    "interface": [
      "interface {interface}",
      " {mode_phrase}",
      "?description  description {description}",
      " {vlan_phrase}",
      "?ip  {ip_phrase}",
      "?poe  {poe_phrase}",
      " {shutdown_phrase}",
      " quit"
    ],
    "footer": [
      "#",
      "return"
    ]
  },
