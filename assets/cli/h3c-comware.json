{
  "schema_version": "1.0",
  "profile_id": "h3c-comware",
  "vendor_id": "h3c",
  "modes": {
    "user": {
      "prompt_key": "user",
      "description": "用户视图",
      "enter_command": null
    },
    "config": {
      "prompt_key": "config",
      "description": "系统视图",
      "enter_command": "system-view"
    },
    "interface": {
      "prompt_key": "interface",
      "description": "接口视图",
      "enter_command": "interface {interface}"
    },
    "vlan": {
      "prompt_key": "vlan",
      "description": "VLAN 视图",
      "enter_command": "vlan {vlan}"
    }
  },
  "commands": [
