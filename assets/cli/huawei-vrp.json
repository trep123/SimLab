      "output": [
        "PHY: Physical",
        "*down: administratively down",
        "^down: standby",
        "(l): loopback",
        "(s): spoofing",
        "(E): E-Trunk down",
        "(b): BFD down",
        "(e): ETHOAM down",
        "(dl): DLDP down",
        "(lb): LBDT block",
