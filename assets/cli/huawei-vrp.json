      "syntax": "display version",
      "aliases": [
        "dis ver",
        "dis version",
        "display ver"
      ],
      "modes": [
        "user",
        "config",
        "interface",
        "vlan"
      ],
      "help": "查看系统软件版本与运行时间",
      "handler": "show_version",
      "args": [],
      "output": [
        "Huawei Versatile Routing Platform Software",
        "{os_version}",
        "Copyright (C) 2012-2024 Huawei Technologies Co., Ltd.",
        "HUAWEI {product_name} uptime is {uptime}",
        "BKP  version information:",
        "1. PCB      Version  : VER.B",
        "2. Board    Type     : {model}",
        "3. MPU      Type     : MCUD",
        "4. LPU      Type     : Not Present",
        "5. MPU Slot Quantity : 1",
        "6. LPU Slot Quantity : 0",
        "",
        "SDRAM: 2048 M bytes, Flash: 1024 M bytes",
        "MPU version information:",
        "1. PCB      Version  : VER.B",
        "2. Board    Type     : {model}",
        "3. Serial Number     : {serial_number}",
        "4. MAC Address       : {mac_address}"
      ]
    },
    {
      "id": "huawei.show.interface_brief",
      "syntax": "display interface brief",
