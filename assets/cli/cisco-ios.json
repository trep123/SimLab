{
  "schema_version": "1.0",
  "profile_id": "cisco-ios",
  "vendor_id": "cisco",
  "modes": {
    "user": {
      "prompt_key": "user",
      "description": "用户执行模式",
      "enter_command": null
    },
    "privileged": {
      "prompt_key": "privileged",
      "description": "特权执行模式",
      "enter_command": "enable"
    },
    "config": {
      "prompt_key": "config",
      "description": "全局配置模式",
      "enter_command": "configure terminal"
    },
    "interface": {
      "prompt_key": "interface",
      "description": "接口配置模式",
      "enter_command": "interface {interface}"
    },
    "vlan": {
      "prompt_key": "vlan",
      "description": "VLAN 配置模式",
      "enter_command": "vlan {vlan}"
    }
  },
