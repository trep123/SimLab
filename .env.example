DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5181,http://127.0.0.1:5181
SIMLAB_RUNTIME_MODE=development_mock
SIMLAB_DEMO_USERNAME=demo
SIMLAB_DEMO_PASSWORD=
SIMLAB_HOST_AGENT_SOCKET=/run/simlab/host-agent.sock
SIMLAB_HOST_AGENT_TIMEOUT_SECONDS=180
SIMLAB_EXTERNAL_DOMAINS=simlab-g0-pc1,simlab-g0-pc2
SIMLAB_G0_PC1_BRIDGE_ENABLED=1
SIMLAB_DESKTOP_RUNTIME_BRIDGE_ENABLED=1
SIMLAB_DESKTOP_EXTERNAL_DOMAINS=simlab-g0-pc1,simlab-g0-pc2
SIMLAB_DESKTOP_NOVNC_BASE_URL=/novnc/vnc.html
SIMLAB_G0_PC1_DOMAIN=simlab-g0-pc1
SIMLAB_G0_PC1_NOVNC_URL='/g0-novnc/vnc.html?autoconnect=1&resize=scale&path=g0-novnc/websockify'
DATABASE_URL=sqlite:///runtime-data/simlab.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/1
EVENT_STREAM_REDIS_URL=redis://127.0.0.1:6379/2
SIMLAB_EVENT_STREAM_KEY=simlab:events:v1
SIMLAB_EVENT_STREAM_GROUP=simlab-event-relay-v1
SIMLAB_CHANNEL_PREFIX=simlab
SIMLAB_MAX_RUNNING_DEVICES=8
POSTGRES_PASSWORD=replace-for-local-compose
